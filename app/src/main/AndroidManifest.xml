<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ScanFire has no server and sends no data anywhere. INTERNET is used to download language
         models once (ML Kit translation, Tesseract OCR) and for 'Send to computer' on the local Wi-Fi.
         Scanner and OCR models are fetched by Google Play services. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To find the phone's Wi-Fi address for 'Send to computer' (a server on the local network only). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Document reminders ("passport expires"): a notification on the chosen day, re-armed after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ScanFireApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScanFire">

        <!-- Ask Play services to fetch the Latin OCR and language-ID models at install time, so first use is instant. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,langid" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to ScanFire" for photos and PDFs. -->
            <intent-filter android:label="Add to ScanFire">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- "Open with ScanFire". -->
            <intent-filter android:label="Open in ScanFire">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Launcher shortcuts. -->
            <intent-filter>
                <action android:name="com.ganim.scanfire.action.SCAN" />
                <action android:name="com.ganim.scanfire.action.SCAN_CODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
